# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database (MongoDB Atlas or local) ----
MONGODB_URI=mongodb+srv://Manimarank900:speed107@cluster0.zulyvkg.mongodb.net/?appName=Cluster0

# ---- CORS: comma separated. Wildcards allowed, e.g. https://*.vercel.app ----
CORS_ORIGINS=http://localhost:3000

# ---- Admin dashboard auth ----
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
ADMIN_EMAIL=admin@riyadvisoftwaretechnologies.com
# Preferred: bcrypt hash  ->  npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
# Dev-only convenience (ignored when ADMIN_PASSWORD_HASH is set; rejected in production)
ADMIN_PASSWORD=change-me-in-dev

# ---- Email notifications (optional; skipped when SMTP_HOST is empty) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Riyadvi Website <no-reply@riyadvisoftwaretechnologies.com>"
NOTIFY_EMAIL=info@riyadvisoftwaretechnologies.com
